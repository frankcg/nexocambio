              "mode": "raw",
              "raw": "{\n  \"tipo_cliente\": \"persona\",\n  \"nombres\": \"Lucía\",\n  \"apellidos\": \"Ramírez Torres\",\n  \"tipo_documento\": \"DNI\",\n  \"numero_documento\": \"{{dni}}\",\n  \"fecha_nacimiento\": \"1994-05-10\",\n  \"telefono\": \"987654321\",\n  \"ocupacion\": \"Dependiente\",\n  \"pep\": false,\n  \"correo\": \"{{correo}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
