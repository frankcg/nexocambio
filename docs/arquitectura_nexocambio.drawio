ell><mxCell id="sns_ti" value="SNS — alertas" style="text;html=1;align=left;verticalAlign=top;fontStyle=1;fontSize=13.5;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="sns"><mxGeometry x="62" y="8" width="193" height="26" as="geometry"/></mxCell><mxCell id="sns_de" value="Notificación por correo cuando salta una alarma" style="text;html=1;align=left;verticalAlign=top;fontSize=11.5;fontColor=#4A5568;whiteSpace=wrap;lineHeight=130%;" vertex="1" parent="sns"><mxGeometry x="62" y="31.5" width="193" height="62.5" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#E7157B;strokeWidth=2;fontColor=#E7157B;fontSize=11;jettySize=auto;dashed=1;dashPattern=6 5;" edge="1" parent="1" source="layer" target="cw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#E7157B;strokeWidth=2;fontColor=#E7157B;fontSize=11;jettySize=auto;dashed=1;dashPattern=6 5;" edge="1" parent="1" source="cw" target="sns"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="métricas de la API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#E7157B;strokeWidth=2;fontColor=#E7157B;fontSize=11;jettySize=auto;dashed=1;dashPattern=6 5;" edge="1" parent="1" source="apigw" target="cw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="notas" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F0F5FF;strokeColor=#3B48CC;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1290" y="300" width="265" height="440" as="geometry"/></mxCell><mxCell id="notas_ti" value="Decisiones de diseño" style="text;html=1;align=left;verticalAlign=top;fontStyle=1;fontSize=13.5;fontColor=#3B48CC;whiteSpace=wrap;" vertex="1" parent="notas"><mxGeometry x="14" y="10" width="241" height="34" as="geometry"/></mxCell><mxCell id="notas_de" value="• Cada microservicio tiene su propia base de datos.&lt;br&gt;• Operaciones NO confía en la tasa del navegador: la valida con Cotizaciones (Lambda→Lambda).&lt;br&gt;• Contraseñas con PBKDF2; sesión con JWT (2 h).&lt;br&gt;• Back-office (/admin): clave compartida x-admin-key en vez de JWT; aprueba o rechaza.&lt;br&gt;• Comprobantes: bucket privado, validación de formato real y enlaces temporales.&lt;br&gt;• Pago por uso: sin servidores encendidos 24×7.&lt;br&gt;• Frontend Angular en S3, por HTTPS (endpoint REST de S3).&lt;br&gt;• Todo el stack (Lambdas, DynamoDB, S3, API, CloudFront) se aprovisiona con CloudFormation (deploy.sh)." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;whiteSpace=wrap;lineHeight=138%;" vertex="1" parent="notas"><mxGeometry x="14" y="44" width="241" height="388" as="geometry"/></mxCell><mxCell id="fuera" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A94A6;strokeWidth=1.2;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="20" y="705" width="150" height="150" as="geometry"/></mxCell><mxCell id="fuera_ti" value="Fuera de alcance (no implementado):" style="text;html=1;align=left;verticalAlign=top;fontStyle=1;fontSize=11.5;fontColor=#5B6B85;whiteSpace=wrap;" vertex="1" parent="fuera"><mxGeometry x="14" y="10" width="126" height="34" as="geometry"/></mxCell><mxCell id="fuera_de" value="Cognito (usuarios y roles reales)&lt;br&gt;&lt;br&gt;EventBridge + SES (avisos de estado)" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;whiteSpace=wrap;lineHeight=138%;" vertex="1" parent="fuera"><mxGeometry x="14" y="44" width="126" height="98" as="geometry"/></mxCell><mxCell id="t23" value="Flujo MVP: cotizar → registrarse / iniciar sesión → registrar operación → adjuntar comprobante → back-office aprueba o rechaza → consultar estado" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#0E1B33;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="942" width="1600" height="30" as="geometry"/></mxCell>
