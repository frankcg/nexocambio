  "item": [
    {
      "name": "1. Cotizaciones (público)",
      "item": [
        {
          "name": "Cotizar - Casa de Cambio (PEN→USD)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"Devuelve tasa y monto\", () => { pm.expect(j.tasa).to.be.above(0); pm.expect(j.monto_destino).to.be.above(0); });",
                  "pm.collectionVariables.set(\"id_cotizacion_demo\", j.id_cotizacion);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cotizar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cotizar"
              ]
            },
            "description": "Calcula tasa y monto estimado. Vigencia 5 minutos.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"modalidad\": \"casa\",\n  \"moneda_origen\": \"PEN\",\n  \"moneda_destino\": \"USD\",\n  \"monto_origen\": 1000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
