        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Devuelve JWT\", () => pm.expect(j.token.split(\".\")).to.have.length(3));",
                  "pm.test(\"No expone el hash\", () => pm.expect(JSON.stringify(j)).to.not.include(\"password_hash\"));",
                  "pm.collectionVariables.set(\"token\", j.token);",
                  "pm.collectionVariables.set(\"id_cliente\", j.cliente.id_cliente);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "",
            "body": {
