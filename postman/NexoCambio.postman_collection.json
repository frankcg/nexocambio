    {
      "name": "2. Clientes y autenticación",
      "item": [
        {
          "name": "Registro - persona natural",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Date.now();",
                  "pm.collectionVariables.set(\"correo\", \"cliente\" + n + \"@nexocambio.pe\");",
                  "pm.collectionVariables.set(\"dni\", String(10000000 + Math.floor(Math.random() * 89999999)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"id_cliente\", pm.response.json().id_cliente);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
